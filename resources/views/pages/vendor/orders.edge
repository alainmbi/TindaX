                    @if(order.user.phone)
                      <p class="mt-1 text-sm text-slate-500">{{ order.user.phone }}</p>
                    @end
                  </div>

                  <div class="grid gap-3 sm:grid-cols-2">
                    <div class="rounded-[1.25rem] border border-white bg-white/80 p-4">
                      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-400">
                        Adresse de livraison
                      </p>
                      <p class="mt-2 text-sm leading-7 text-slate-700">
                        {{ order.deliveryAddress }}
                      </p>
                    </div>
                    <div class="rounded-[1.25rem] border border-white bg-white/80 p-4">
                      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-400">
                        Total
                      </p>
                      <p class="mt-2 font-display text-2xl font-semibold text-tindax-950">
                        {{ Number(order.totalPrice).toFixed(2) }} USD
                      </p>
                    </div>
                  </div>

                  <div class="rounded-[1.25rem] border border-white bg-white/80 p-4">
                    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-400">
                      Lignes de commande
                    </p>
                    <div class="mt-3 space-y-2">
                      @each(item in order.items)
                        <div class="flex items-center justify-between gap-4 rounded-[1rem] bg-mist px-4 py-3">
                          <div>
                            <p class="text-sm font-semibold text-slate-800">
                              {{ item.product?.name || 'Produit archive' }}
                            </p>
                            <p class="mt-1 text-xs text-slate-500">
                              Quantite : {{ item.quantity }}
                            </p>
                          </div>
                          <span class="text-sm font-semibold text-tindax-900">
                            {{ Number(item.unitPrice).toFixed(2) }} USD
                          </span>
                        </div>
                      @end
                    </div>
                  </div>
                </div>

                <div class="grid gap-3 xl:w-64">
                  <form
                    action="{{ route('vendor.orders.advanceStatus', { orderId: order.id }) }}"
                    method="POST"
                  >
                    {{ csrfField() }}
                    <button
                      type="submit"
                      class="{{
                        order.status === 'pending'
                          ? 'inline-flex w-full items-center justify-center rounded-full bg-amber-400 px-5 py-3 text-sm font-semibold text-amber-950 transition hover:bg-amber-300'
                          : order.status === 'preparing'
                            ? 'inline-flex w-full items-center justify-center rounded-full bg-emerald-500 px-5 py-3 text-sm font-semibold text-white transition hover:bg-emerald-400'
                            : order.status === 'ready'
                              ? 'inline-flex w-full items-center justify-center rounded-full bg-sky-500 px-5 py-3 text-sm font-semibold text-white transition hover:bg-sky-400'
                              : 'inline-flex w-full items-center justify-center rounded-full bg-slate-200 px-5 py-3 text-sm font-semibold text-slate-500'
                      }}"
                      {{ ['delivered', 'cancelled'].includes(order.status) ? 'disabled' : '' }}
                    >
                      {{
                        order.status === 'pending'
                          ? 'Passer en preparation'
                          : order.status === 'preparing'
                            ? 'Marquer pret'
                            : order.status === 'ready'
                              ? 'Marquer livre'
                              : order.status === 'delivered'
                                ? 'Commande terminee'
                                : 'Commande annulee'
                      }}
                    </button>
                  </form>

                  <form
                    action="{{ route('vendor.orders.cancel', { orderId: order.id }) }}"
                    method="POST"
                  >
                    {{ csrfField() }}
                    <button
                      type="submit"
                      class="inline-flex w-full items-center justify-center rounded-full border border-rose-200 bg-white px-5 py-3 text-sm font-semibold text-rose-700 transition hover:bg-rose-50"
                      {{ ['delivered', 'cancelled'].includes(order.status) ? 'disabled' : '' }}
                    >
                      Annuler la commande
                    </button>
                  </form>
                </div>
              </div>
            </article>
          @else
