@merchantLayout()
  <section class="px-4 pb-8 pt-8 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl space-y-8">
      <div class="overflow-hidden rounded-[2.25rem] bg-hero-glow text-white shadow-soft">
        <div class="grid gap-6 px-6 py-8 sm:px-8 sm:py-10 xl:grid-cols-[1.1fr_0.9fr] xl:px-10">
          <div class="space-y-6">
            <div class="flex flex-wrap items-center gap-3">
              <span class="rounded-full border border-white/15 bg-white/10 px-4 py-2 text-xs font-semibold uppercase tracking-[0.24em] text-gold-100">
                Dashboard TindaX
              </span>
              <span class="rounded-full border border-white/15 bg-white/10 px-4 py-2 text-xs font-medium text-white/78">
                Gestion marchande premium et mobile-first
              </span>
            </div>

            <div class="flex flex-col gap-5 sm:flex-row sm:items-start">
              @if(store.logoImage)
                <img
                  src="{{ store.logoImage }}"
                  alt="Logo de {{ store.name }}"
                  class="h-24 w-24 rounded-[1.75rem] border border-white/15 object-cover shadow-panel"
                />
              @else
                <div class="flex h-24 w-24 items-center justify-center rounded-[1.75rem] border border-white/15 bg-white/10 text-3xl font-extrabold text-white shadow-panel">
                  {{ store.name.slice(0, 1).toUpperCase() }}
                </div>
              @end

              <div class="max-w-2xl">
                <p class="font-display text-sm font-semibold uppercase tracking-[0.24em] text-gold-200">
                  Accueil administration
                </p>
                <h1 class="mt-3 font-display text-3xl font-semibold tracking-tight sm:text-4xl lg:text-5xl">
                  {{ store.name }}
                </h1>
                <p class="mt-4 text-sm leading-8 text-white/78 sm:text-base">
                  {{ store.description || 'Votre espace marchand centralise le pilotage de la boutique, du catalogue et des commandes dans une interface nette et rassurante.' }}
                </p>
                <div class="mt-5 flex flex-wrap items-center gap-3 text-sm text-white/78">
                  <span class="rounded-full border border-white/12 bg-white/10 px-4 py-2">
                    {{ store.address }}
                  </span>
                  @if(store.latitude && store.longitude)
                    <span class="rounded-full border border-white/12 bg-white/10 px-4 py-2">
                      {{ store.latitude }}, {{ store.longitude }}
                    </span>
                  @end
                </div>
              </div>
            </div>
          </div>

          <div class="rounded-[2rem] border border-white/12 bg-white/10 p-5 backdrop-blur-xl">
            <div class="grid gap-4 sm:grid-cols-2">
              <div class="rounded-[1.5rem] border border-white/12 bg-white/10 p-4">
                <p class="text-sm text-white/72">Produits actifs</p>
                <p class="mt-2 font-display text-3xl font-semibold">{{ stats.productsCount }}</p>
              </div>
              <div class="rounded-[1.5rem] border border-white/12 bg-white/10 p-4">
                <p class="text-sm text-white/72">Commandes a traiter</p>
                <p class="mt-2 font-display text-3xl font-semibold">{{ stats.pendingCount }}</p>
              </div>
              <div class="rounded-[1.5rem] border border-white/12 bg-white/10 p-4">
                <p class="text-sm text-white/72">Commandes du jour</p>
                <p class="mt-2 font-display text-3xl font-semibold">{{ stats.todaysOrdersCount }}</p>
              </div>
              <div class="rounded-[1.5rem] border border-white/12 bg-white/10 p-4">
                <p class="text-sm text-white/72">Ventes du jour</p>
                <p class="mt-2 font-display text-3xl font-semibold">
                  {{ Number(stats.todaysSales).toFixed(2) }} USD
                </p>
              </div>
            </div>

            <div id="parametres" class="mt-5 rounded-[1.5rem] border border-white/12 bg-white/10 p-4">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <p class="text-sm font-semibold text-white">Pilotage boutique</p>
                  <p class="mt-1 text-sm leading-7 text-white/72">
                    Ouvrez ou fermez la reception des commandes a la volonte.
                  </p>
                </div>

                <form action="{{ route('vendor.store.status') }}" method="POST">
                  {{ csrfField() }}
                  <input
                    type="hidden"
                    name="storeStatus"
                    value="{{ store.status === 'ouvert' ? 'ferme' : 'ouvert' }}"
                  />
                  <button
                    type="submit"
                    class="{{
                      store.status === 'ouvert'
                        ? 'inline-flex items-center justify-center rounded-full bg-emerald-400 px-5 py-3 text-sm font-semibold text-emerald-950 transition hover:bg-emerald-300'
                        : 'inline-flex items-center justify-center rounded-full bg-white/90 px-5 py-3 text-sm font-semibold text-slate-800 transition hover:bg-white'
                    }}"
                  >
                    {{ store.status === 'ouvert' ? 'Boutique ouverte' : 'Boutique fermee' }}
                  </button>
                </form>
              </div>

              @inputError('storeStatus')
                @each(message in $messages)
                  <p class="mt-3 text-sm font-medium text-rose-100">{{ message }}</p>
                @end
              @end
            </div>
          </div>
        </div>
      </div>

      <div class="grid gap-8 xl:grid-cols-[0.82fr_1.18fr]">
        <section class="rounded-[2rem] border border-tindax-100 bg-white p-6 shadow-panel sm:p-8">
          <p class="font-display text-sm font-semibold uppercase tracking-[0.28em] text-tindax-700">
            Raccourcis
          </p>
          <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight text-tindax-950">
            Gardez la main sur l'essentiel.
          </h2>
          <p class="mt-4 text-sm leading-8 text-slate-600">
            Accedez rapidement aux zones critiques de votre boutique pour mettre a jour l'offre ou
            traiter les commandes prioritaires.
          </p>

          <div class="mt-8 grid gap-4">
            <a
              href="{{ route('vendor.products') }}"
              class="rounded-[1.6rem] border border-tindax-100 bg-mist px-5 py-5 transition hover:border-tindax-300 hover:bg-white"
            >
              <p class="font-display text-xl font-semibold text-tindax-950">Catalogue produits</p>
              <p class="mt-2 text-sm leading-7 text-slate-600">
                Ajoutez, editez, illustrez et pilotez la disponibilite de vos fiches produit.
              </p>
            </a>

            <a
              href="{{ route('vendor.orders') }}"
              class="rounded-[1.6rem] border border-tindax-100 bg-mist px-5 py-5 transition hover:border-tindax-300 hover:bg-white"
            >
              <p class="font-display text-xl font-semibold text-tindax-950">Commandes recues</p>
              <p class="mt-2 text-sm leading-7 text-slate-600">
                Suivez les commandes, faites progresser les statuts et anticipez les annulations.
              </p>
            </a>
          </div>
        </section>

        <section class="rounded-[2rem] border border-tindax-100 bg-white p-6 shadow-panel sm:p-8">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="font-display text-sm font-semibold uppercase tracking-[0.28em] text-tindax-700">
                Commandes prioritaires
              </p>
              <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight text-tindax-950">
                Dernieres commandes a surveiller.
              </h2>
            </div>
            <a
              href="{{ route('vendor.orders') }}"
              class="text-sm font-semibold text-tindax-700 transition hover:text-tindax-900"
            >
              Voir toutes les commandes
            </a>
          </div>

          <div class="mt-8 space-y-4">
            @each(order in recentOrders)
              <article class="rounded-[1.5rem] border border-slate-100 bg-mist/60 p-5">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                  <div>
                    <div class="flex flex-wrap items-center gap-3">
                      <span class="rounded-full bg-white px-3 py-1.5 text-xs font-semibold text-slate-500 shadow-sm">
                        Commande #{{ order.id }}
                      </span>
                      <span
                        class="{{
                          order.status === 'pending'
                            ? 'rounded-full bg-amber-100 px-3 py-1.5 text-xs font-semibold text-amber-900'
                            : order.status === 'preparing'
                              ? 'rounded-full bg-emerald-100 px-3 py-1.5 text-xs font-semibold text-emerald-800'
                              : order.status === 'ready'
                                ? 'rounded-full bg-sky-100 px-3 py-1.5 text-xs font-semibold text-sky-800'
                                : order.status === 'delivered'
                                  ? 'rounded-full bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white'
                                  : 'rounded-full bg-rose-100 px-3 py-1.5 text-xs font-semibold text-rose-800'
                        }}"
                      >
                        {{
                          order.status === 'pending'
                            ? 'En attente'
                            : order.status === 'preparing'
                              ? 'En preparation'
                              : order.status === 'ready'
                                ? 'Pret'
                                : order.status === 'delivered'
                                  ? 'Livre'
                                  : 'Annule'
                        }}
                      </span>
                    </div>

                    <p class="mt-4 font-display text-xl font-semibold text-tindax-950">
                      {{ order.user.fullName }}
                    </p>
                    <p class="mt-1 text-sm text-slate-500">{{ order.deliveryAddress }}</p>
                  </div>

                  <div class="sm:text-right">
                    <p class="font-display text-2xl font-semibold text-tindax-950">
                      {{ Number(order.totalPrice).toFixed(2) }} USD
                    </p>
                    <p class="mt-1 text-xs font-medium text-slate-400">
                      {{ order.createdAt.toFormat('dd LLL yyyy, HH:mm') }}
                    </p>
                  </div>
                </div>
              </article>
            @else
              <div class="rounded-[1.75rem] border border-dashed border-slate-200 bg-mist/60 p-8 text-center">
                <p class="font-display text-2xl font-semibold text-tindax-950">
                  Aucune commande recente.
                </p>
                <p class="mx-auto mt-3 max-w-2xl text-sm leading-8 text-slate-600">
                  Les nouvelles commandes apparaitront ici pour donner au marchand une vision
                  immediate de l'activite.
                </p>
              </div>
            @end
          </div>
        </section>
      </div>
    </div>
  </section>
@end
