                                    (old('editProductId') === String(product.id)
                                      ? (old('editStatus') || product.status)
                                      : product.status) === 'rupture'
                                      ? 'selected'
                                      : ''
                                  }}
                                >
                                  En rupture
                                </option>
                              </select>
                              @if(old('editProductId') === String(product.id))
                                @inputError('editStatus')
                                  @each(message in $messages)
                                    <p class="mt-2 text-sm font-medium text-rose-600">{{ message }}</p>
                                  @end
                                @end
                              @end
                            </div>
                          </div>

                          <button
                            type="submit"
                            class="inline-flex items-center justify-center rounded-full bg-tindax-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-tindax-800"
                          >
                            Enregistrer les modifications
                          </button>
                        </form>
                      </div>
                    </details>

                    <form
                      action="{{ route('vendor.products.toggleStatus', { productId: product.id }) }}"
                      method="POST"
                      class="sm:w-auto"
                    >
                      {{ csrfField() }}
                      <button
                        type="submit"
                        class="{{
                          product.status === 'disponible'
                            ? 'inline-flex w-full items-center justify-center rounded-[1.4rem] border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-700 transition hover:bg-emerald-100 sm:w-auto'
                            : 'inline-flex w-full items-center justify-center rounded-[1.4rem] border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-semibold text-rose-700 transition hover:bg-rose-100 sm:w-auto'
                        }}"
                      >
                        {{ product.status === 'disponible' ? 'Passer en rupture' : 'Remettre disponible' }}
                      </button>
                    </form>

                    <form
                      action="{{ route('vendor.products.destroy', { productId: product.id }) }}"
                      method="POST"
                      class="sm:w-auto"
                    >
                      {{ csrfField() }}
                      <button
                        type="submit"
                        class="inline-flex w-full items-center justify-center rounded-[1.4rem] border border-rose-200 bg-white px-4 py-3 text-sm font-semibold text-rose-700 transition hover:bg-rose-50 sm:w-auto"
                      >
                        Supprimer
                      </button>
                    </form>
                  </div>
                </div>
              </article>
            @else
              <div class="sm:col-span-2">
                <div class="rounded-[2rem] border border-dashed border-slate-200 bg-white p-8 text-center shadow-panel">
                  <p class="font-display text-2xl font-semibold text-tindax-950">
                    Votre catalogue est encore vide.
                  </p>
                  <p class="mx-auto mt-3 max-w-xl text-sm leading-8 text-slate-600">
                    Ajoutez votre premier produit pour commencer a structurer votre boutique TindaX
                    et preparer une presentation premium de votre offre.
                  </p>
                </div>
              </div>
            @end
          </div>
        </section>
      </div>
    </div>
  </section>
@end
